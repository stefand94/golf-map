#!/bin/sh
# GOLF-84: force a fresh service-worker install on every push that changes
# any precached file, so a returning visitor's browser never gets stuck
# serving stale cache-first content (see scripts/update_sw_cache_version.py
# for the full why). Runs automatically on `git push` once this repo has
#   git config core.hooksPath .githooks
# set (one-time, per clone — see scripts/README.md).
#
# Behaviour: since GOLF-205 the stamp is normally committed straight after
# the commit that needs it, by .githooks/post-commit. This is the backstop
# for anything that skipped that (a rebase, a merge, a clone without the
# hooks path set). If HEAD still needs a stamp, it is committed here, and if
# HEAD is part of this push the push is stopped: git has already fixed the
# list of commits to send, so the stamp would otherwise ship one push late.
# Re-running `git push` sends both.

set -e
cd "$(git rev-parse --show-toplevel)"

PUSHING="$(cat)"
OLD_HEAD="$(git rev-parse HEAD)"
set +e
python3 scripts/update_sw_cache_version.py --commit
STAMP=$?
set -e
if [ "$STAMP" -eq 3 ]; then
  if printf '%s\n' "$PUSHING" | grep -q " $OLD_HEAD "; then
    echo "pre-push: HEAD needed a build-version stamp; committed it as $(git rev-parse --short HEAD)."
    echo "          Push stopped so the stamp goes out with it. Run git push again."
    exit 1
  fi
elif [ "$STAMP" -ne 0 ]; then
  exit "$STAMP"
fi

# GOLF-164: same idea for the Cloudflare Worker — stamp a content hash into
# it so X-Worker-Build answers "is the deployed Worker this source?" in one
# curl. The Worker isn't precached by sw.js (different origin), so it needs
# its own stamper rather than a line in the one above.
python3 scripts/update_worker_build.py

# GOLF-164: committed separately from the sw.js bump — they version different
# things (the site's precached shell vs the Worker's source) and a push that
# changes one usually doesn't change the other.
#
# Unlike sw.js and js/app-version.js, ors-proxy.js is hand-edited, so this
# must never sweep up someone's in-progress Worker changes into an
# auto-commit. It commits only when the working-tree diff is confined to the
# WORKER_BUILD line; anything else and it says so and leaves the file alone,
# because a stamp pushed without the code it describes is worse than no stamp.
if ! git diff --quiet -- scripts/cloudflare-worker/ors-proxy.js; then
  if [ -z "$(git diff -U0 -- scripts/cloudflare-worker/ors-proxy.js \
             | grep -E '^[+-]' | grep -vE '^(\+\+\+|---)' | grep -v 'WORKER_BUILD')" ]; then
    git add scripts/cloudflare-worker/ors-proxy.js
    git commit -m "ors-proxy.js: auto-stamp WORKER_BUILD (Worker source changed)" -q
    echo "pre-push: ors-proxy.js WORKER_BUILD stamped and committed automatically."
  else
    echo "pre-push: ors-proxy.js has uncommitted changes beyond WORKER_BUILD —"
    echo "          leaving it alone. Commit them yourself; the stamp goes with them."
  fi
fi
